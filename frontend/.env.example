# PHI Console frontend configuration. Copy to frontend/.env.
#
# Base URL of the backend API, with no trailing slash, e.g.
# "http://localhost:8001". Leave empty (the default) when the frontend is
# served from the same origin as the backend -- the Docker/compose setup in
# this repo does exactly that, so the built production bundle should be
# built with this left blank.
REACT_APP_BACKEND_URL=
