# PHI Console backend configuration. Copy to backend/.env and fill in the
# blanks. Python >= 3.11 required.
#
# `python server.py` (via uvicorn) refuses to boot when PHI_ENV != "dev" and
# any of the production-required variables below is missing or insecure
# (server.py: boot-time config validation, 4.1).

# --- Runtime mode -----------------------------------------------------------

# "dev" or "production". "dev" relaxes every check below (no token required,
# CORS wide open, unauthenticated Mongo allowed, keys auto-generated) so a
# local checkout runs with zero configuration. Default is "production": an
# operator who forgets to set this gets the safe behavior, not the
# convenient one.
PHI_ENV=dev

# --- Identity and access -----------------------------------------------------

# Comma-separated "name:token" pairs, e.g. "alice:s3cr3t,bob:an0th3r". Every
# mutating and owner-scoped route requires one of these tokens. Required in
# production. A bare API_TOKEN=<token> is also accepted and maps to the
# principal "operator" (legacy single-operator form).
API_TOKENS=
API_TOKEN=

# Comma-separated list of exact origins the browser UI is served from, e.g.
# "https://phi.example.org". Never "*" in production -- the boot check
# refuses to start if it is empty or contains a wildcard.
CORS_ALLOWED_ORIGINS=http://localhost:3000

# --- Database ----------------------------------------------------------------

# Must include authentication credentials in production, e.g.
# "mongodb://root:<password>@mongo:27017/?authSource=admin". The unauthenticated
# default below is fine for local dev only.
MONGO_URL=mongodb://localhost:27017
DB_NAME=phi_handling

# --- Storage -------------------------------------------------------------------

# Root directory for uploaded ZIPs, unpacked study files, and exports.
# Created with mode 0700 on every boot. Must sit on an encrypted volume in
# production; this application does not encrypt files at rest itself.
DATA_DIR=/app/data

# --- Cryptography --------------------------------------------------------------

# Base64 Fernet key protecting BYO LLM provider keys at rest. Generate with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Required in production; in dev a key is generated and persisted to .env
# automatically if this is left blank.
APP_ENCRYPTION_KEY=

# Base64-encoded PKCS8 Ed25519 private key used to sign the shareable
# attestation bundle. Generate with:
#   python -c "
#   from cryptography.hazmat.primitives.asymmetric.ed25519 import Ed25519PrivateKey
#   from cryptography.hazmat.primitives.serialization import Encoding, PrivateFormat, NoEncryption
#   import base64
#   k = Ed25519PrivateKey.generate()
#   print(base64.b64encode(k.private_bytes(Encoding.DER, PrivateFormat.PKCS8, NoEncryption())).decode())"
# Required in production; when unset in dev the attestation ships unsigned
# ("signed": false).
ATTESTATION_SIGNING_KEY=

# --- Retention and capacity ------------------------------------------------

# Days a settled session (complete/failed/cancelled/blocked/intake_failed)
# is kept before the hourly purge job deletes its document, files, and logs.
RETENTION_DAYS=30

# Cap on pipelines running at once in this process. /handle returns 429 with
# Retry-After when the cap is reached.
MAX_CONCURRENT_PIPELINES=2

# Hard byte cap on a single uploaded file.
MAX_UPLOAD_BYTES=262144000

# Intake ZIP guards: total uncompressed bytes, max entry count, and max
# compression ratio (zip-bomb defense).
INTAKE_MAX_TOTAL_BYTES=1073741824
INTAKE_MAX_ENTRIES=500
INTAKE_MAX_RATIO=100

# Action applied to a dataset column present in the source but with no
# Judge/Sentinel decision (SEC-004 fail-closed default). "drop" or
# "scrub_text".
PHI_UNMAPPED_COLUMN_ACTION=drop

# Comma-separated hostnames allowed for a custom openai_compatible LLM
# base_url. Empty means no custom base_url is accepted.
ALLOWED_LLM_BASE_URL_HOSTS=

# --- LLM provider credentials (bring at least one) --------------------------

ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=
OPENROUTER_API_KEY=

# --- Advanced / optional -----------------------------------------------------

# ChatGPT (Codex-style) OAuth login storage. Defaults are fine for a single
# container deployment; override only for a shared/mounted token store.
# CHATGPT_TOKEN_DIR=/app/data/chatgpt
# CHATGPT_AUTH_FILE=auth.json

# Read by the Docker image's CMD (not by server.py itself). Address/CIDR
# uvicorn trusts to supply X-Forwarded-For; default "127.0.0.1" is correct
# when there is no reverse proxy, or one on the same host/network
# namespace. Set this to your reverse proxy's address when fronting the
# app with one on a different address -- otherwise every real client
# shares one IP-keyed rate-limit bucket (4.20). Never "*" unless the
# network path guarantees no client can reach this port directly.
# FORWARDED_ALLOW_IPS=127.0.0.1
