# RePORTal PHI Pipeline — Makefile fragment
# Usage: make -f Makefile.fragment study STUDY=<name>
# Or copy these targets into your existing Makefile.

STUDY ?= $(error STUDY is required, e.g. make study STUDY=IndoVAP)
STUDYARG := $(if $(STUDY),--study $(STUDY),)
FORCE ?=
RESUME ?=
STRICT ?=
PRUNE ?=

.PHONY: study organize rebuild-llm-source

study:
	STUDY_NAME=$(STUDY) \
	$(if $(FORCE),REPORTAL_FORCE=1,) \
	$(if $(RESUME),REPORTAL_RESUME=1,) \
	$(if $(STRICT),REPORTAL_SCRUB_STRICT_ABORT=1,) \
	python plugins/report-ai-study-pipeline/skills/report-ai-study-pipeline/scripts/run.py

organize:
	$(if $(STUDY),STUDY_NAME=$(STUDY),) \
	$(if $(PRUNE),PRUNE=1,) \
	python plugins/report-ai-study-pipeline/skills/raw-data-intake/scripts/run.py $(STUDYARG)

rebuild-llm-source:
	STUDY_NAME=$(STUDY) python -c "\
	import shutil, config; \
	shutil.rmtree(config.STUDY_LLM_SOURCE_DIR, ignore_errors=True); \
	shutil.rmtree(config.STAGING_DATASETS_DIR, ignore_errors=True)" \
	&& $(MAKE) -f Makefile.fragment study STUDY=$(STUDY)
