# Python
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
*.egg
*.egg-info/
dist/
build/
.pytest_cache/
.coverage
htmlcov/
.tox/
.mypy_cache/
.ruff_cache/

# Virtual environments
venv/
env/
.venv/
ENV/

# IDE
.vscode/
.idea/
*.swp
*.swo
*~

# OS
.DS_Store
Thumbs.db

# Secrets (NEVER commit)
.env
.env.*
!.env.example
*.pem
*.key
credentials.json
aws-credentials.ini

# Real PHI (NEVER commit)
real_phi/
real_data/
production_data/
*.real.csv
*.real.json
*.real.xlsx

# Runtime session artifacts (pod-local; never commit)
# These fill GPFS file quotas and break git pull with ENOSPC.
data/uploads/*
!data/uploads/.gitkeep
data/exports/*
!data/exports/.gitkeep

# Large generated outputs (regenerate locally)
corpus/generated/*.tar.gz
benchmarks/results/*.detailed.json
# Logs
*.log
logs/
.logs/

# Local build artifacts
tmp/
*.tmp
.phi-local-*
*.env
.credentials
/.worktrees/

# phi_engine's default (PHI_WORKSPACE-unset) repo-root workspace -- this is
# where a direct `python -m phi_engine intake/organize/run/review/status`
# invocation (no --workspace passed) lands its scaffolding. Ephemeral,
# regenerated by re-running the pipeline; never a source of truth.
/intake/
/organized/
/output/
/data/

# Per-study generated scrub/privacy config, synthesized fresh each pipeline
# run into phi_engine/config/<STUDY>/ (see phi_engine/pipeline/synthesize_config.py).
# Only the packaged defaults (_defaults/) and the static config.py/*.yaml
# files are source of truth; per-study output is ephemeral, regenerated,
# and left behind by running the pipeline against the repo-root default workspace.
/phi_engine/config/*/
!/phi_engine/config/_defaults/

# Research archive (deep-research outputs, workflow logs)
# These are exploratory notes, not part of any release artifact.
research/

# ------------------------------------------------------------------
# Generated / regenerable output. NEVER commit. See CLAUDE.md
# "Generated artifacts and cleanup". Anything a command can recreate
# belongs here, today and for every future run.
# ------------------------------------------------------------------
# Test and campaign reports (pytest --junitxml, phi_corpus.generate --campaign)
test_reports/
coverage.xml
.coverage.*

# Corpus generator output
data/corpus/
*.groundtruth.json

# Node dependency tree
node_modules/

# Agent and harness scratch state
.superpowers/
.impeccable/
.phi-build-status
intake-v3-final

# Emergent hosting-platform artifacts (job metadata, webhook crons, bot
# git identity) -- this codebase runs on any host and carries no
# platform-specific state.
/.emergent/
/.gitconfig

# Planning, specs, and agent memory. The repo holds code, current how-to
# documentation, decision records, config, and test inputs. Anything that
# records what was planned, tracked, or remembered lives outside the tree.
/tasks/
/memory/
/docs/assurance/
/docs/superpowers/
/design_guidelines.json
/docs/MASTER_ARCHITECTURE_V2.md

# Generated API reference (python backend/scripts/export_openapi.py)
/docs/API.md


spec.md
.playwright-mcp/
