# Large generated outputs (regenerate locally)
corpus/generated/*.tar.gz
benchmarks/results/*.detailed.json

# Logs
*.log
logs/

# Local build artifacts
tmp/
*.tmp
.phi-local-*
/.worktrees/

# phi_engine's default (PHI_WORKSPACE-unset) repo-root workspace -- this is
# where harness/run_phi_system.py's documented evidence commands (see
# README.md "Evidence commands") land their intake/organize/run scaffolding
# when no --workspace is passed. Ephemeral, regenerated by re-running the
# evidence commands; never a source of truth (that's benchmarks/results/).
/intake/
/organized/
/output/
/data/

# Per-study generated scrub/privacy config, synthesized fresh each pipeline
# run into phi_engine/config/<STUDY>/ (see phi_engine/pipeline/synthesize_config.py).
# Only the packaged defaults (_defaults/) and the static config.py/*.yaml
# files are source of truth; per-study output is ephemeral, regenerated,
# and left behind by running the same repo-root-default evidence commands.
/phi_engine/config/*/
!/phi_engine/config/_defaults/

# Research archive (deep-research outputs, SWOT analyses, workflow logs)
# These are exploratory notes, not part of the corpus or IRB submission.
research/

